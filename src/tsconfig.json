{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "module": "esnext",
    "removeComments": false,
    "sourceMap": true,
    "declaration": true,
    "outDir": "../dist",
    "lib": ["esnext", "dom"],
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "ignoreDeprecations": "6.0"
  },
  "include": ["."]
}
