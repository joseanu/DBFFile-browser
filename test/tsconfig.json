{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "target": "es2018",
    "rootDir": "..",
    "module": "commonjs",
    "removeComments": false,
    "sourceMap": true,
    "declaration": true,
    "outDir": "../dist/test",
    "lib": ["es2018", "dom"],
    "ignoreDeprecations": "5.0",
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["."]
}
