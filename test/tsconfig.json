{
    "compilerOptions": {
        "target": "es2018",
        "rootDir": "..",
        "module": "commonjs",
        "moduleResolution": "node",
        "removeComments": false,
        "sourceMap": true,
        "declaration": true,
        "outDir": "../dist/test",
        "lib": ["es2018", "dom"],
        "ignoreDeprecations": "6.0",

        "strict": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noFallthroughCasesInSwitch": true,
    }
}
