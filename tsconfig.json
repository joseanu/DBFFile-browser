{
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "target": "ES2017",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "strictNullChecks": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": false,
    "incremental": false,
    "isolatedModules": true,
    "jsx": "preserve",
    "plugins": [],
    "paths": {},
    "allowJs": false,
    "types": ["node"],
    "ignoreDeprecations": "5.0",
    "forceConsistentCasingInFileNames": true
  }
}
